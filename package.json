{
  "name": "@YukiHayakawa/design-tokens",
  "version": "1.0.0",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./themes.json": "./dist/themes.json",
    "./themes": {
      "types": "./dist/themes.d.ts",
      "default": "./dist/themes.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.mjs",
    "prepack": "pnpm build",
    "prestorybook": "pnpm build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/react-vite": "10.5.8",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.8",
    "typescript": "6.0.3"
  }
}
